e;\n+\n+        // Find the closest enemy within range\n+        this.target = null;\n+        let closestDistance = this.config.range;\n+\n+        for (const enemy of enemies) {\n+            if (!enemy.isAlive()) continue;\n+\n+            const distance = this.position.distanceTo(enemy.getPosition());\n+            if (distance < closestDistance) {\n+                closestDistance = distance;\n+                this.target = enemy;\n+            }\n+        }\n+\n+        // Rotate turret towards target\n+        if (this.target) {\n+            const targetPos = this.target.getPosition();\n+            const direction = targetPos.clone().sub(this.turret.position).normalize();\n+            const angle = Math.atan2(direction.x, direction.z);\n+            this.turret.rotation.y = angle;\n+\n+            // Attack if ready\n+            if (this.timeSinceLastAttack >= 1 / this.config.attackSpeed) {\n+                this.attack();\n+                this.timeSinceLastAttack = 0;\n+            }\n+        }\n+    }"[m[1;38m,[m
