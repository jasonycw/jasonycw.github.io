[1;34m"body"[m[1;38m:[m [32m"![medium](https://www.gstatic.com/codereviewagent/medium-priority.svg)\n\nThe health bar foreground positioning logic is incorrect. The current formula `(1 - healthRatio) * 5 - 5` causes the bar to be misaligned with the background (which is centered at 0). For a bar that is 10 units wide and centered, anchoring it to the left requires the position to be `(healthRatio - 1) * 5`.\n\n```suggestion\n        this.healthBarFg.position.x = (healthRatio - 1) * 5; // Adjust position to align left\n```"[m[1;38m,[m
[1;34m"diff_hunk"[m[1;38m:[m [32m"@@ -0,0 +1,117 @@\n+import * as THREE from 'three';\n+import { GameConfig } from './GameConfig.js';\n+\n+export class Enemy {\n+    constructor(scene, path, waveNumber = 1) {\n+        this.scene = scene;\n+        this.path = path; // Array of waypoints\n+        this.pathIndex = 0;\n+        this.progress = 0; // Progress between current and next waypoint (0 to 1)\n+        this.alive = true;\n+        this.waveNumber = waveNumber;\n+\n+        // Enemy properties\n+        this.maxHP = GameConfig.enemy.maxHP * GameConfig.wave.enemyHealthMultiplier(waveNumber);\n+        this.hp = this.maxHP;\n+        this.speed = GameConfig.enemy.speed;\n+        this.damage = GameConfig.enemy.damage;\n+        this.reward = GameConfig.enemy.reward;\n+\n+        // Create visual representation (simple cone for now)\n+        this.createMesh();\n+    }\n+\n+    createMesh() {\n+        const geometry = new THREE.ConeGeometry(5, 15, 8);\n+        const material = new THREE.MeshPhongMaterial({ color: 0xFF4500 }); // Orange-red for typhoon\n+        this.mesh = new THREE.Mesh(geometry, material);\n+        this.mesh.position.copy(this.path[0]);\n+        this.mesh.position.y = 7.5; // Half the height of the cone\n+        this.scene.add(this.mesh);\n+\n+        // Add a health bar above the enemy\n+        this.createHealthBar();\n+    }\n+\n+    createHealthBar() {\n+        const barWidth = 10;\n+        const barHeight = 1;\n+        const barGeometry = new THREE.PlaneGeometry(barWidth, barHeight);\n+\n+        // Background (red)\n+        const bgMaterial = new THREE.MeshBasicMaterial({ color: 0xFF0000 });\n+        this.healthBarBg = new THREE.Mesh(barGeometry, bgMaterial);\n+        this.healthBarBg.position.y = 20;\n+        this.mesh.add(this.healthBarBg);\n+\n+        // Foreground (green)\n+        this.healthBarFg = new THREE.Mesh(barGeometry, new THREE.MeshBasicMaterial({ color: 0x00FF00 }));\n+        this.healthBarFg.position.y = 20;\n+        this.healthBarFg.position.z = 0.1;\n+        this.mesh.add(this.healthBarFg);\n+    }\n+\n+    update(deltaTime) {\n+        if (!this.alive) return;\n+\n+        // Move along the path\n+        const moveDistance = this.speed * deltaTime;\n+        const segmentLength = this.path[this.pathIndex].distanceTo(this.path[this.pathIndex + 1]);\n+        this.progress += moveDistance / segmentLength;\n+\n+        if (this.progress >= 1) {\n+            this.pathIndex++;\n+            this.progress = 0;\n+\n+            if (this.pathIndex >= this.path.length - 1) {\n+                // Enemy reached the end\n+                this.alive = false;\n+                this.scene.remove(this.mesh);\n+                return true; // Signal that enemy reached the end\n+            }\n+        }\n+\n+        // Interpolate position between waypoints\n+        const currentWaypoint = this.path[this.pathIndex];\n+        const nextWaypoint = this.path[this.pathIndex + 1];\n+        this.mesh.position.lerpVectors(currentWaypoint, nextWaypoint, this.progress);\n+        this.mesh.position.y = 7.5;\n+\n+        // Rotate to face the direction of movement\n+        const direction = nextWaypoint.clone().sub(currentWaypoint).normalize();\n+        const angle = Math.atan2(direction.x, direction.z);\n+        this.mesh.rotation.y = angle;\n+\n+        return false;\n+    }\n+\n+    takeDamage(amount) {\n+        this.hp -= amount;\n+        this.updateHealthBar();\n+\n+        if (this.hp <= 0) {\n+            this.die();\n+            return true; // Signal that enemy died\n+        }\n+        return false;\n+    }\n+\n+    updateHealthBar() {\n+        const healthRatio = Math.max(0, this.hp / this.maxHP);\n+        this.healthBarFg.scale.x = healthRatio;\n+        this.healthBarFg.position.x = (1 - healthRatio) * 5 - 5; // Adjust position to align left"[m[1;38m,[m
